# Copy to .env and fill in. Never commit .env — it is git-ignored.

# --- WhatsApp ---------------------------------------------------------------
# JID of the parade-state group, e.g. 120363001234567890@g.us
#
# To find it: leave this blank, set LOG_LEVEL=debug, and run `bun start`. The
# listener then accepts every chat and logs each message's remoteJid, so posting
# once in the target group reveals its JID. Fill it in and restart.
WA_GROUP_ID=

# --- Apps Script web app ----------------------------------------------------
# The /exec URL of the deployed web app. Do NOT include a query string; the
# bridge appends ?route=paradestate itself.
# Looks like https://script.google.com/macros/s/<long-id>/exec
APPS_SCRIPT_URL=

# Must match the WHATSAPP_INGEST_TOKEN script property set by Config.setup().
# Any long random string; generate one rather than choosing it by hand.
APPS_SCRIPT_TOKEN=

# --- Runtime ----------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# Set to 1 to log accepted messages instead of relaying them.
DRY_RUN=0
